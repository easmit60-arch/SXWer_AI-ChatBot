# Example environment configuration for SXWer AI ChatBot
# Copy this file to .env and replace the values with your own local settings.
# Never commit a real .env file or any real API keys.

# Optional online AI settings
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_BASE=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
ONLINE_API_ENABLED=false

# Optional external tool settings
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_USER_ID=your_apify_user_id_here
AGENT_ID=your_agent_id_here

# Local runtime settings
PORT=3000
OFFLINE_MODE=true
LOCAL_MODEL_PATH=./models

# ---------------------------------------------------------------------------
# Python microservice (optional — enables NLP, local LLM, and voice features)
# Start with: cd python && uvicorn app:app --host 127.0.0.1 --port 8000
# ---------------------------------------------------------------------------
PYTHON_API_URL=http://localhost:8000

# Local LLM via Ollama (fully offline, no API key required)
# Install: https://ollama.ai/download  |  Pull model: ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Voice — Speech to Text (Vosk, offline)
# Download model: https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=./models/vosk-model

# Voice — Text to Speech engine: "pyttsx3" (default, offline) or "mimic3"
TTS_ENGINE=pyttsx3

# Mimic 3 TTS (optional, higher quality)
# Run: docker run -d -p 59125:59125 mycroftai/mimic3
MIMIC3_URL=http://localhost:59125

# Set to "true" to enable FastAPI /docs endpoint (local development only)
ENABLE_DOCS=false
