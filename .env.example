# Example environment configuration for SXWer AI ChatBot
# Copy this file to .env and replace the values with your own local settings.
# Never commit a real .env file or any real API keys.

# Optional online AI settings
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_BASE=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
ONLINE_API_ENABLED=false

# Optional external tool settings
APIFY_API_TOKEN=your_apify_api_token_here
APIFY_USER_ID=your_apify_user_id_here
AGENT_ID=your_agent_id_here

# Optional MCP client settings (JSON string)
MCP_SERVERS_JSON={"mcpServers":{"RapidAPI Hub - Horoscope":{"command":"npx","args":["mcp-remote","https://mcp.rapidapi.com","--header","x-api-host: horoscopeapi-horoscope-v1.p.rapidapi.com","--header","x-api-key: your_rapidapi_key_here"]}}}

# Local runtime settings
PORT=3000
OFFLINE_MODE=true
LOCAL_MODEL_PATH=./models

# ---------------------------------------------------------------------------
# Python microservice (optional — enables NLP, local LLM, and voice features)
# Start with: cd python && uvicorn app:app --host 127.0.0.1 --port 8000
# ---------------------------------------------------------------------------
PYTHON_API_URL=http://localhost:8000

# Local LLM via Ollama (fully offline, no API key required)
# Install: https://ollama.ai/download  |  Pull model: ollama pull mistral
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# Voice — Speech to Text (Vosk, offline)
# Download model: https://alphacephei.com/vosk/models
VOSK_MODEL_PATH=./models/vosk-model

# Voice — Text to Speech engine: "pyttsx3" (default, offline) or "mimic3"
TTS_ENGINE=pyttsx3

# Mimic 3 TTS (optional, higher quality)
# Run: docker run -d -p 59125:59125 mycroftai/mimic3
MIMIC3_URL=http://localhost:59125

# Set to "true" to enable FastAPI /docs endpoint (local development only)
ENABLE_DOCS=false

# ---------------------------------------------------------------------------
# Optional Blockchain Consent Ledger
# The app works fully offline without any of these settings.
# Blockchain is NEVER activated without explicit user consent.
# Only cryptographic consent hashes are stored — never personal data.
# ---------------------------------------------------------------------------

# Set to "true" only after the user has read and accepted the disclosure
BLOCKCHAIN_ENABLED=false

# Provider: mock | ethereum | polygon | hyperledger | hedera | consortium
# "mock" stores receipts in memory only — no network calls
BLOCKCHAIN_PROVIDER=mock

# Ethereum / Polygon / Consortium (EVM) settings
ETHEREUM_RPC_URL=
ETHEREUM_CHAIN_ID=
CONSENT_CONTRACT_ETH=

POLYGON_RPC_URL=
POLYGON_CHAIN_ID=
CONSENT_CONTRACT_POLY=

CONSORTIUM_RPC_URL=
CONSORTIUM_CHAIN_ID=
CONSENT_CONTRACT_CONSORTIUM=

# Hyperledger Fabric settings
HYPERLEDGER_GATEWAY=
HYPERLEDGER_CHANNEL=
HYPERLEDGER_CHAINCODE=

# Hedera Hashgraph settings
HEDERA_NETWORK=testnet
HEDERA_TOPIC_ID=
HEDERA_OPERATOR_ID=
# HEDERA_OPERATOR_KEY must NEVER be committed. Set it in your local .env only.
# HEDERA_OPERATOR_KEY=

# Mock provider: set to "true" to persist mock receipts to disk (local dev only)
MOCK_LEDGER_PERSIST=false

