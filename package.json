{
  "name": "sxwer-ai-chatbot",
  "version": "1.0.0",
  "description": "Trauma-informed, privacy-first AI support tool for sex workers - offline web app",
  "main": "server-offline.js",
  "type": "module",
  "scripts": {
    "start": "node server-offline.js",
    "start:usb": "OFFLINE_MODE=true node server-offline.js",
    "dev": "nodemon server-offline.js",
    "test": "node --test",
    "test:a11y": "node --test tests/accessibility.test.js",
    "bundle": "npm install --production && npm prune --production",
    "bundle:usb": "npm run bundle && echo 'Copy entire directory to USB drive'"
  },
  "keywords": [
    "sex-worker",
    "safety",
    "trauma-informed",
    "privacy",
    "offline",
    "ai",
    "chatbot"
  ],
  "author": "SXWers",
  "license": "MIT",
  "dependencies": {
    "arweave": "^1.15.7",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.6",
    "csrf": "^3.1.0",
    "dotenv": "^17.4.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^7.1.0",
    "ipfs-http-client": "^58.0.1",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "axe-core": "^4.12.1",
    "jsdom": "^30.0.1",
    "nodemon": "^3.1.0",
    "pa11y": "^9.1.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "cpu": [
    "x64",
    "arm64"
  ],
  "allowScripts": {
    "puppeteer@24.43.1": true
  }
}
