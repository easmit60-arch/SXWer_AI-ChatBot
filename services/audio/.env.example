# Mistral Audio Service Configuration
# Copy this file to .env and fill in your values

# ============================================================================
# MISTRAL API CONFIGURATION
# ============================================================================

# Your Mistral API key (required)
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your-mistral-api-key-here

# ============================================================================
# SERVICE CONFIGURATION (Optional - can override defaults)
# ============================================================================

# TTS Model (default: voxtral-mini-tts-2603)
# MISTRAL_TTS_MODEL=voxtral-mini-tts-2603

# STT Model (default: voxtral-mini-latest)
# MISTRAL_STT_MODEL=voxtral-mini-latest

# Default TTS Voice (default: en_esme_neutral)
# MISTRAL_TTS_VOICE=en_esme_neutral

# ============================================================================
# RATE LIMITING (Optional - adjust as needed)
# ============================================================================

# TTS requests per minute (default: 10)
# MISTRAL_TTS_RATE_LIMIT_MAX=10

# STT requests per minute (default: 5)
# MISTRAL_STT_RATE_LIMIT_MAX=5

# Rate limit window in milliseconds (default: 60000 = 1 minute)
# MISTRAL_RATE_LIMIT_WINDOW_MS=60000

# ============================================================================
# TIMEOUTS (Optional)
# ============================================================================

# API request timeout in milliseconds (default: 30000 = 30 seconds)
# MISTRAL_API_TIMEOUT_MS=30000

# ============================================================================
# LOGGING (Optional)
# ============================================================================

# Enable debug logging (default: false)
# MISTRAL_AUDIO_DEBUG=true

# Log level (default: info)
# MISTRAL_AUDIO_LOG_LEVEL=info
